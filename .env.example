# Environment Variables
# Copy this file to .env.local and populate values for local development.

# Firebase Configuration (local emulator)
VITE_FIREBASE_API_KEY=local
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Use Firebase Emulators
VITE_USE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_HOST=localhost
VITE_AUTH_EMULATOR_PORT=9099
VITE_FUNCTIONS_EMULATOR_HOST=localhost
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Feature Flags
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_FHIR_API=false