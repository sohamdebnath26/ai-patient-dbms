# Environment Variables
# Copy this file to .env.local and populate values for local development.

# Firebase Configuration
VITE_FIREBASE_API_KEY=local
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Emulator Mode
# Set to "true" to use local Firebase emulators
# Set to "false" to connect to staging/production Firebase projects
VITE_USE_EMULATORS=true

# Emulator Hosts (only used when VITE_USE_EMULATORS=true)
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_HOST=localhost
VITE_AUTH_EMULATOR_PORT=9099
VITE_STORAGE_EMULATOR_HOST=localhost
VITE_STORAGE_EMULATOR_PORT=9199
VITE_FUNCTIONS_EMULATOR_HOST=localhost
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Feature Flags
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_FHIR_API=false

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# DeepSeek AI Configuration
VITE_DEEPSEEK_API_KEY=your-deepseek-api-key