# Environment Variables
# Copy this file to .env.local and populate values for local development.

# Firebase Configuration
VITE_FIREBASE_API_KEY=local
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Emulator Mode
# Set to "true" to use local Firebase emulators
# Set to "false" to connect to staging/production Firebase projects
VITE_USE_EMULATORS=true

# Emulator Hosts (only used when VITE_USE_EMULATORS=true)
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_HOST=localhost
VITE_AUTH_EMULATOR_PORT=9099
VITE_STORAGE_EMULATOR_HOST=localhost
VITE_STORAGE_EMULATOR_PORT=9199
VITE_FUNCTIONS_EMULATOR_HOST=localhost
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Feature Flags
VITE_ENABLE_AI_FEATURES=false
VITE_ENABLE_FHIR_API=false

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Chatbot (Supabase Edge Function)
# Set this only in .env.local if you want the frontend to point at a non-default
# function path. The function itself reads DEEPSEEK_API_KEY from Supabase secrets.
# VITE_CHAT_FUNCTION_NAME=chat

# DeepSeek AI Configuration (via OpenRouter)
# Set this in Vercel Environment Variables (or .env.local for dev).
# It is NEVER exposed to the browser — all AI calls go through /api/chat.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here