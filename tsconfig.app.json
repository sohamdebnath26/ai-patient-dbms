{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["./src/domain/*"],
      "@domain/patient/*": ["./src/domain/patient/*"],
      "@domain/clinical/*": ["./src/domain/clinical/*"],
      "@domain/tenant/*": ["./src/domain/tenant/*"],
      "@domain/auth/*": ["./src/domain/auth/*"],
      "@domain/shared/*": ["./src/domain/shared/*"],
      "@application/*": ["./src/application/*"],
      "@application/patient/*": ["./src/application/patient/*"],
      "@application/clinical/*": ["./src/application/clinical/*"],
      "@application/ai/*": ["./src/application/ai/*"],
      "@application/tenant/*": ["./src/application/tenant/*"],
      "@application/ports/*": ["./src/application/ports/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@infrastructure/firebase/*": ["./src/infrastructure/firebase/*"],
      "@infrastructure/ai/*": ["./src/infrastructure/ai/*"],
      "@infrastructure/encryption/*": ["./src/infrastructure/encryption/*"],
      "@infrastructure/http/*": ["./src/infrastructure/http/*"],
      "@presentation/*": ["./src/presentation/*"],
      "@presentation/components/*": ["./src/presentation/components/*"],
      "@presentation/pages/*": ["./src/presentation/pages/*"],
      "@presentation/hooks/*": ["./src/presentation/hooks/*"],
      "@presentation/layouts/*": ["./src/presentation/layouts/*"],
      "@presentation/design-system/*": ["./src/presentation/design-system/*"],
      "@ai/*": ["./src/ai/*"],
      "@ai/prompts/*": ["./src/ai/prompts/*"],
      "@ai/models/*": ["./src/ai/models/*"],
      "@ai/pipelines/*": ["./src/ai/pipelines/*"],
      "@ai/evaluation/*": ["./src/ai/evaluation/*"],
      "@lib/*": ["./src/lib/*"],
      "@test/*": ["./src/test/*"],
      "@config/*": ["./src/config/*"]
    },

    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "functions"]
}
